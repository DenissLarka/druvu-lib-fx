<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.druvu</groupId>
		<artifactId>druvu-lib-fx-parent</artifactId>
		<version>1.0.2-SNAPSHOT</version>
	</parent>

	<artifactId>druvu-lib-fx</artifactId>
	<packaging>jar</packaging>

	<name>DRUVU.COM / LIB / FX / CORE</name>
	<description>The toolkit: bus, exec, status, auth, nav, prefs, notify, util. A library, not a framework - nothing here requires implementing a toolkit interface to start an app.</description>

	<dependencies>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- THEME -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- Compile scope on purpose: com.druvu.lib.fx.theme wraps it and module-info re-exports it
		     ('requires transitive'), so apps get AtlantaFX's Styles/Tweaks constants for free. -->
		<dependency>
			<groupId>io.github.mkpaz</groupId>
			<artifactId>atlantafx-base</artifactId>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- LOG -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- LOMBOK -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- TEST -->
		<!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<!-- normal resources (dock css + png indicators) -->
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- Bundle the licenses into the jar's META-INF. The jar carries vendored MPL-2.0 code
			     (com.druvu.lib.fx.dock), so the MPL-2.0 text must travel with the binary distribution. -->
			<resource>
				<directory>${maven.multiModuleProjectDirectory}</directory>
				<targetPath>META-INF</targetPath>
				<includes>
					<include>LICENSE</include>
					<include>NOTICE.md</include>
					<include>licenses/MPL-2.0.txt</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<!-- DRUVU THEMES step 1: unpack AtlantaFX's SCSS sources (atlantafx-styles) so the druvu
			     theme entry files can @forward its settings modules with the brand ramps. Version-locked
			     to the runtime by sharing ${atlantafx.version}: the compiled CSS can never come from a
			     different styles generation than the atlantafx-base on the module path. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>${maven-dependency-plugin.version}</version>
				<executions>
					<execution>
						<id>unpack-atlantafx-styles</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>io.github.mkpaz</groupId>
									<artifactId>atlantafx-styles</artifactId>
									<version>${atlantafx.version}</version>
									<type>jar</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/atlantafx-styles</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- DRUVU THEMES step 2: compile the theme SCSS to user-agent CSS, straight into
			     target/classes so it ships in the jar next to FxTheme - which fails loudly at
			     class-load if these files are missing. The plugin fetches dart-sass per platform. -->
			<plugin>
				<groupId>us.hebi.sass</groupId>
				<artifactId>sass-cli-maven-plugin</artifactId>
				<version>${sass-cli-maven-plugin.version}</version>
				<configuration>
					<args>
						<arg>--load-path=${project.build.directory}/atlantafx-styles/atlantafx/styles</arg>
						<arg>--no-source-map</arg>
						<arg>${project.basedir}/src/main/scss/druvu-dark.scss:${project.build.outputDirectory}/com/druvu/lib/fx/theme/druvu-dark.css</arg>
						<arg>${project.basedir}/src/main/scss/druvu-light.scss:${project.build.outputDirectory}/com/druvu/lib/fx/theme/druvu-light.css</arg>
					</args>
				</configuration>
				<executions>
					<execution>
						<id>compile-druvu-themes</id>
						<phase>process-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
